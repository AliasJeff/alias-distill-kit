{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "python": "${workspaceFolder}/venv/bin/python",
            "program": "${file}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug train_teacher",
            "type": "python",
            "request": "launch",
            "python": "${workspaceFolder}/venv/bin/python",
            "program": "${workspaceFolder}/main.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": ["train-teacher"]
        },
        {
            "name": "Debug distillation",
            "type": "python",
            "request": "launch",
            "python": "${workspaceFolder}/venv/bin/python",
            "program": "${workspaceFolder}/main.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": ["train"]
        }
    ]
}